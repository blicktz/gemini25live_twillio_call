            "format": "uuid",
            "title": "Business Id"
          },
          "caller_phone_number": {
            "type": "string",
            "title": "Caller Phone Number"
          },
          "call_start_time": {
            "type": "string",
            "format": "date-time",
            "title": "Call Start Time"
          },
          "call_duration_seconds": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
