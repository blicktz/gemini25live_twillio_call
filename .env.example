# Twilio Configuration
# Get these from your Twilio Console: https://console.twilio.com/
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Optional: Set this to your public webhook URL if different from default
# This should be the publicly accessible URL where Twilio can reach your server
# Example: https://your-domain.com or https://your-ngrok-url.ngrok.io
TWILIO_WEBHOOK_URL=

# Gemini API Configuration
# Get your API key from Google AI Studio: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use (options: gemini-2.5-flash-preview, gemini-2.5-flash-exp, gemini-pro)
GEMINI_MODEL=gemini-2.5-flash-preview

# Server Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Audio Configuration (Advanced - usually don't need to change)
INPUT_SAMPLE_RATE=8000
GEMINI_INPUT_SAMPLE_RATE=16000
GEMINI_OUTPUT_SAMPLE_RATE=24000
OUTPUT_SAMPLE_RATE=8000

# AI Configuration
SYSTEM_PROMPT="You are a friendly and helpful AI assistant answering phone calls. Keep your responses conversational, concise, and natural. Respond as if you're having a real-time voice conversation."