# Twilio Configuration
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_PHONE_NUMBER="+1234567890" # Your Twilio phone number
# If using ngrok or similar for local development, set your public URL here
BASE_URL="http://localhost:8000"

# Gemini API Configuration
GEMINI_API_KEY="your_gemini_api_key"

# Application Configuration
LOG_LEVEL="INFO"
# Secret key for verifying Twilio requests (optional, but recommended for production)
TWILIO_REQUEST_VALIDATION_SECRET="your_strong_secret_key"
